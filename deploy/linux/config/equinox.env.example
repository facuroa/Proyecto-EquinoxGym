# Este archivo se completa automáticamente con crear-base-local.sh.
SERVER_PORT=8085
DB_URL=jdbc:mysql://localhost:3306/equinoxgym?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=equinox_app
DB_PASSWORD=CAMBIAR
JPA_DDL_AUTO=update
THYMELEAF_CACHE=true
EQUINOX_ADMIN_USERNAME=admin
EQUINOX_ADMIN_PASSWORD=CAMBIAR
GYM_NAME=Keep Fit Gym
GYM_LOGO_PATH=

# Envio automatico de comprobantes y recordatorios de vencimiento por email.
# Para activarlo: generar una "contrasena de aplicacion" de Gmail (con la
# verificacion en dos pasos activada), completar MAIL_USERNAME/MAIL_PASSWORD
# y poner EMAIL_NOTIFICACIONES_HABILITADO=true.
EMAIL_NOTIFICACIONES_HABILITADO=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Dias de anticipacion con los que se manda el recordatorio de vencimiento.
RECORDATORIO_DIAS_ANTICIPACION=3
